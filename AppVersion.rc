#include <windows.h>
#include "AppVersion.generated.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_RESOURCE
 PRODUCTVERSION APP_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "UnlockIt"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "UnlockIt"
            VALUE "OriginalFilename", "UnlockIt.exe"
            VALUE "ProductName", "UnlockIt"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
